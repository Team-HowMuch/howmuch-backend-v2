{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://howmuch.team/schemas/certificate-result-v1.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "messageId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "messageType": {
          "const": "REGISTERED"
        },
        "sessionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "sessionVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 40
        },
        "connectionRef": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        }
      },
      "required": [
        "schemaVersion",
        "messageId",
        "messageType",
        "sessionId",
        "sessionVersion",
        "occurredAt",
        "connectionRef"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "messageId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "messageType": {
          "const": "REGISTRATION_UNKNOWN"
        },
        "sessionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "sessionVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 40
        },
        "failureCode": {
          "const": "REGISTRATION_UNCERTAIN"
        }
      },
      "required": [
        "schemaVersion",
        "messageId",
        "messageType",
        "sessionId",
        "sessionVersion",
        "occurredAt",
        "failureCode"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "messageId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "messageType": {
          "const": "REGISTRATION_FAILED"
        },
        "sessionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "sessionVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 40
        },
        "failureCode": {
          "oneOf": [
            {
              "enum": [
                "REGISTRATION_REJECTED",
                "ADDITIONAL_AUTH_REQUIRED",
                "UPLOAD_EXPIRED",
                "PROVIDER_UNAVAILABLE",
                "CONTRACT_CONFLICT"
              ]
            },
            {
              "type": "string",
              "pattern": "^CF-[0-9]{5}$",
              "minLength": 8,
              "maxLength": 8,
              "not": {
                "const": "CF-00000"
              }
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "messageId",
        "messageType",
        "sessionId",
        "sessionVersion",
        "occurredAt",
        "failureCode"
      ],
      "additionalProperties": false
    }
  ]
}
