{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://howmuch.team/schemas/notification-delivery-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["messageId", "messageType", "schemaVersion", "occurredAt", "deliveryId", "generation", "recipientUserId"],
  "properties": {
    "messageId": {"type": "string", "format": "uuid"},
    "messageType": {"const": "NotificationDeliveryRequested"},
    "schemaVersion": {"const": 1},
    "occurredAt": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "deliveryId": {"type": "string", "format": "uuid"},
    "generation": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "recipientUserId": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}
  }
}
