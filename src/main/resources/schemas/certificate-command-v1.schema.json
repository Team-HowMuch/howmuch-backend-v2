{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://howmuch.team/schemas/certificate-command-v1.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "messageId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "messageType": {
          "const": "REGISTER"
        },
        "sessionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "sessionVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 40
        },
        "organization": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "uploadRef": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "deadlineAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 40
        }
      },
      "required": [
        "schemaVersion",
        "messageId",
        "messageType",
        "sessionId",
        "sessionVersion",
        "occurredAt",
        "organization",
        "uploadRef",
        "deadlineAt"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "messageId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "messageType": {
          "const": "CANCEL"
        },
        "sessionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "sessionVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 40
        },
        "organization": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        }
      },
      "required": [
        "schemaVersion",
        "messageId",
        "messageType",
        "sessionId",
        "sessionVersion",
        "occurredAt",
        "organization"
      ],
      "additionalProperties": false
    }
  ]
}
